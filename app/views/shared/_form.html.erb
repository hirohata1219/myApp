<%= render 'shared/error_messages', object: @post %>
<%= form_with model: @post, html: {class: "form-container"} do |form| %>
  <div class="form-input">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: 'タイトルを入力してください' %>
  </div>
  <div class="form-input">
    <%= form.label :content %>
    <%= form.text_area :content, placeholder: '本文を入力してください' %>
  </div>
  <div class="button-container">
    <%= form.submit submit_label, class: "link-button" %>
  </div>
<% end %>