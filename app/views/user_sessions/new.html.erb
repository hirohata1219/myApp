<% content_for(:title, t('.title')) %>
<div class="container">
  <div class="row">
    <div class=" col-md-10 col-lg-8 mx-auto">
      <h1><%= "ログイン" %></h1>
      <%= form_with url: login_path, class: "form-container" do |f| %>
        <div class="form-input">
          <%= f.label :email %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="form-input">
          <%= f.label :password %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
        <%= f.submit "ログイン", class: "link-button" %>
      <% end %>
      <div class='form-container'>
        <div class="form-input">
          <%= link_to "新規登録", new_user_path %>
          <%# t('.to_register_page')  %>
        </div>
        <div class="form-input">
          <%= link_to "パスワードお忘れの方", '#' %>
          <%# t('.password_forget') %>
        </div>
      </div>
    </div>
  </div>
</div>
