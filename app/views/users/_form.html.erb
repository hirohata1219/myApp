<%= form_with model: @user, local: true do |form| %>
<%= render 'shared/error_messages', object: form.object  %>

  <div class="form-container">
    <div>
      <%= form.label :name, '名前', style: "display: block" %>
      <%= form.text_field :name %>
    </div>

    <div>
      <%= form.label :age, '年齢', style: "display: block" %>
      <%= form.number_field :age %>
    </div>

    <div>
      <%= form.label :phone_number, '電話番号', style: "display: block" %>
      <%= form.text_field :phone_number %>
    </div>

    <div>
      <%= form.label :email, 'メールアドレス', style: "display: block" %>
      <%= form.email_field :email %>
    </div>

    <div>
      <%= form.label :password, 'パスワード', style: "display: block" %>
      <%= form.password_field :password %>
    </div>

    <div>
      <%= form.label :password_confirmation, 'パスワード確認', style: "display: block" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div>
      <%= form.submit '登録' %>
    </div>
  </div>

<% end %>
