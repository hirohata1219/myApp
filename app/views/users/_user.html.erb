<div id="<%= dom_id user %>" class="form-container">
  <p class="form-input">
    <strong>名前:</strong>
    <%= user.name %>
  </p>

  <p class="form-input">
    <strong>年齢:</strong>
    <%= user.age %>
  </p>

  <p class="form-input">
    <strong>電話番号:</strong>
    <%= user.phone_number %>
  </p>

  <p class="form-input">
    <strong>メールアドレス:</strong>
    <%= user.email %>
  </p>

</div>